# Copy this file to .env and fill in the values you have.
# Nothing here is required to boot the app — providers/Mongo without a key
# simply show as "unavailable" / fall back to local storage until configured.

# --- LLM providers (configure at least one to chat) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- MongoDB (stores uploaded/preloaded manual metadata + files) ---
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster-url>/
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=automotive_rag

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
